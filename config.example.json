{
  "version": "1.2",
  "storage": {
    "diary_dir": "./diary",
    "summary_dir": "./summary",
    "diary_format": "monthly",
    "diary_filename_pattern": "YYYY-MM.md"
  },
  "input": {
    "modes": {
      "active": {
        "enabled": true,
        "description": "用户主动陈述当天发生的事情"
      },
      "auto_extract": {
        "enabled": true,
        "description": "从日常对话中自动识别和提取日记信号",
        "privacy_filter": true,
        "skip_technical_content": true
      }
    },
    "user_controls": {
      "pause": "用户说'今天不记日记'或'暂停记录'",
      "resume": "用户说'恢复记录'或'继续记'",
      "exclude": "用户说'这段不要记'",
      "review": "用户说'帮我看看今天记了什么'"
    }
  },
  "mood": {
    "scale": "1-10",
    "labels": {
      "1-2": "很低落",
      "3-4": "不太好",
      "5-6": "一般",
      "7-8": "不错",
      "9-10": "非常好"
    }
  },
  "tags": {
    "preset": [
      "工作", "学习", "健康", "运动", "社交", "家庭",
      "财务", "阅读", "创作", "旅行", "美食", "娱乐",
      "思考", "成长", "情绪", "睡眠"
    ],
    "custom": []
  },
  "sections": {
    "description": "以下板块为可选，根据当日内容灵活使用，有则记录，无则跳过",
    "available": [
      "今日事项", "健康", "学习", "工作", "人际关系",
      "环境", "心情", "感悟", "明日计划"
    ]
  },
  "summary": {
    "month_trigger": "用户说'帮我总结这个月'",
    "year_trigger": "用户说'帮我总结今年'",
    "include_mood_trend": true,
    "include_tag_stats": true,
    "note": "周总结已取消，避免过于琐碎"
  },
  "privacy": {
    "description": "自动提取时的隐私保护规则",
    "skip_patterns": [
      "纯技术讨论和问答",
      "代码和具体技术方案",
      "公司内部信息和商业机密",
      "账号密码等敏感信息",
      "用户明确要求不记录的内容"
    ],
    "extract_patterns": [
      "生活化表达和情绪状态",
      "社交互动和人际关系",
      "健康运动和身体状态",
      "天气环境和位置信息",
      "个人感悟和想法灵感"
    ]
  }
}
